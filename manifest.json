{
  "name": "Data Scraper by Tuhin",
  "version": "1.9.3",
  "manifest_version": 3,
  "default_locale": "en",
  "description": "Data Scraper by Tuhin extracts web data and exports it as Excel or CSV files.",
  "action": {
    "default_icon": "data-scraper-icon64.png"
  },
  "permissions": [
    "webRequest",
    "tabs",
    "webNavigation",
    "scripting",
    "storage",
    "alarms",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "incognito": "split",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "icons": {
    "16": "data-scraper-icon16.png",
    "32": "data-scraper-icon32.png",
    "64": "data-scraper-icon64.png",
    "128": "data-scraper-icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "data-scraper-icon64.png",
        "data-scraper-icon128.png",
        "data-scraper-logo.png",
        "serp_default.png",
        "serp_hover.png",
        "optInHook/check-circle.svg",
        "optInHook/close.svg",
        "src/frames_handler.js"
      ],
      "matches": [
        "*://*/*"
      ]
    }
  ],
  "background": {
    "service_worker": "src/background-wrapper.js"
  },
  "options_page": "src/options/options.html",
  "content_scripts": [
    {
      "matches": [
        "*://*/*"
      ],
      "css": [
        "src/onload.css"
      ],
      "js": [
        "js/jquery-3.1.1.min.js",
        "js/sha256.min.js",
        "src/onload.js"
      ]
    },
    {
      "matches": [
        "*://*/*"
      ],
      "js": [
        "src/optInHook/optInHook.js"
      ]
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/onload_fr.js"
      ],
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/onload_start.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*/*"
      ],
      "js": [
        "src/content/serp-badge/serpBadge.js"
      ]
    }
  ]
}
